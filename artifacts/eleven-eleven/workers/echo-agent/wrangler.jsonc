{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eleven-eleven-echo-agent",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ECHO_AGENT_ENABLED": "false",
    "ECHO_AGENT_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ECHO_AGENT_SESSIONS", "class_name": "EchoAgentSession" }
    ]
  },
  "exports": {
    "EchoAgentSession": { "type": "durable-object", "storage": "sqlite" }
  }
}
