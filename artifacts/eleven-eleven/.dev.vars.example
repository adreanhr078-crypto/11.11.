# Copy this file to .dev.vars for local Cloudflare Pages development.
# Never commit .dev.vars or real provider keys.

# Firebase player API. The web API key identifies the Firebase project;
# keep all service-account credentials out of this worker.
FIREBASE_PROJECT_ID=eleveneleven-16435
FIREBASE_WEB_API_KEY=
PLAYER_ALLOWED_ORIGINS=http://localhost:5173,capacitor://localhost

# Bind a private Cloudflare D1 database as PLAYER_DB. This is a dashboard or
# wrangler binding, not a secret stored in this file.

# Echo Network realtime. `npm run dev` injects a temporary local secret and
# these local URLs automatically. Production must configure the same 32+
# character secret in Pages and the dedicated realtime Worker.
PLAYER_REALTIME_URL=http://127.0.0.1:8790
REALTIME_TICKET_SECRET=

ECHO_PROVIDER_ORDER=cloudflare,gemini,openrouter,groq,huggingface
ECHO_MAX_PROVIDER_ATTEMPTS=10
ECHO_PROVIDER_TIMEOUT_MS=12000
ECHO_PROVIDER_DEADLINE_MS=32000

# Gemini Developer API free-tier models. Keep this key server-side.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Recommended zero-cost router for available free models.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=openrouter/free

# Optional open-weight model fallbacks.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

HF_TOKEN=
HF_MODELS=openai/gpt-oss-120b:fastest,Qwen/Qwen2.5-7B-Instruct-1M:fastest

# Allow the native Android origin or another trusted frontend when needed.
ECHO_ALLOWED_ORIGINS=
