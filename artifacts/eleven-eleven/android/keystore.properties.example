# Android Keystore Configuration
#
# Copy this file to android/keystore.properties and fill in your real values.
# Keep the real file private; it contains passwords and paths to your signing key.

# Path to your keystore file.
# This path is resolved from the android/app module.
# Example placements:
#   android/keystore.jks          -> storeFile=../keystore.jks
#   <project-root>/your-keystore.jks -> storeFile=../../your-keystore.jks
storeFile=

# Keystore password
storePassword=

# Key alias
keyAlias=

# Key password
keyPassword=

# Generate a new keystore with:
# keytool -genkey -v -keystore <path> -keyalg RSA -keysize 2048 -validity 10000 -alias <alias>
