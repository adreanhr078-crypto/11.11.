# Client-side build flags. Never put API secrets in this file.
VITE_DEMO_MODE=false

# The original 20-puzzle archive is the active gameplay route for now.
VITE_LEGACY_PUZZLE_ARCHIVE_ENABLED=true

# Awakening Ward remains shipped but is temporarily hidden from player routes.
VITE_AWAKENING_WARD_ENABLED=false

# Optional destination shown after the demo boundary is reached.
VITE_FULL_GAME_URL=

# Firebase Auth / Firestore client configuration.
# These are public Firebase project identifiers, not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional when the player API is hosted on another origin.
# Same-origin deployments use /api/player automatically.
VITE_PLAYER_API_URL=

# Optional Echo AI gateway URLs. Voice derives /transcribe from the chat URL
# when only VITE_ECHO_AI_ENDPOINT is supplied; set this when the paths differ.
VITE_ECHO_AI_ENDPOINT=
VITE_ECHO_TRANSCRIBE_ENDPOINT=
